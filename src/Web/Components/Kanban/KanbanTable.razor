@using MudBlazor
@using KanbanLite.Contracts
@using DataAccess.Enums

<MudTable Items="@(Batches?.Items ?? Array.Empty<KanbanBatchDto>())"
          Hover="true"
          Striped="true"
          Dense="true"
          Bordered="true"
          PageSizeOptions="@(new int[] { 25, 50, 100 })"
          PageSize="Query.PageSize"
          CurrentPage="Query.Page"
          TotalItems="@((int)(Batches?.Total ?? 0))"
          OnPageChanged="OnPageChanged"
          OnPageSizeChanged="OnPageSizeChanged"
          data-testid="kanban-table">
    <ToolBarContent>
        <MudText Typo="Typo.h6" data-testid="kanban-table-title">Lista batchy</MudText>
        <MudSpacer />
        <MudText data-testid="kanban-batch-count">@(Batches?.Total ?? 0) batchy</MudText>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Numer zlecenia</MudTh>
        <MudTh>Numer batcha</MudTh>
        <MudTh>Liczba sztuk</MudTh>
        <MudTh>Postęp</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Etap</MudTh>
        <MudTh>Ostrzeżenie</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Numer zlecenia" data-testid="@($"batch-order-{context.BatchId}")">
            <MudLink Href="@($"/project/{context.ProjectId}")" Typo="Typo.body1" data-testid="@($"batch-order-link-{context.BatchId}")">
                @context.OrderNumber
            </MudLink>
        </MudTd>
        <MudTd DataLabel="Numer batcha" data-testid="@($"batch-no-{context.BatchId}")">@context.BatchNo</MudTd>
        <MudTd DataLabel="Liczba sztuk">@context.Quantity</MudTd>
        <MudTd DataLabel="Postęp" data-testid="@($"batch-progress-{context.BatchId}")">
            <MudProgressLinear Value="@context.ProgressPercent" Color="Color.Primary" />
            <MudText Typo="Typo.caption">@context.ProgressPercent%</MudText>
        </MudTd>
        <MudTd DataLabel="Status" data-testid="@($"batch-status-{context.BatchId}")">
            <BatchStatusSelect BatchId="@context.BatchId"
                               CurrentStatus="@context.Status"
                               OnStatusChanged="OnStatusChanged" />
        </MudTd>
        <MudTd DataLabel="Etap" data-testid="@($"batch-stage-{context.BatchId}")">
            <BatchStageSelect BatchId="@context.BatchId"
                             CurrentStage="@context.Stage"
                             OnStageChanged="OnStageChanged" />
        </MudTd>
        <MudTd DataLabel="Ostrzeżenie">
            @if (InProgressCount > 20 && context.Status == BatchStatus.InProgress)
            {
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
            }
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
    <NoRecordsContent>
        <MudText>Brak aktywnych batchy</MudText>
    </NoRecordsContent>
</MudTable>
