@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<AuthorizeView>
    <Authorized Context="authContext">
        <MudNavMenu>
            <MudNavLink Href="/kanban" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ViewKanban">
                Kanban
            </MudNavLink>
            
            @if (authContext.User.IsInRole("Manager"))
            {
                <MudNavLink Href="/manager/orders/create" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AddTask">
                    Dodaj zlecenie
                </MudNavLink>
                
                <MudNavLink Href="/manager/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">
                    Panel Managera
                </MudNavLink>
            }
            
            <div class="mt-4">
                <form action="api/auth/logout" method="post" style="display: inline;">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Text"
                               Color="Color.Error"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Logout">
                        Wyloguj
                    </MudButton>
                </form>
            </div>
        </MudNavMenu>
    </Authorized>
</AuthorizeView>
