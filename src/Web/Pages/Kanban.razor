@page "/kanban"
@layout MainLayout
@using MudBlazor
@using KanbanLite.Contracts
@using DataAccess.Enums
<PageTitle>Kanban</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (_inProgressCount > 20)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Liczba batchy w statusie InProgress wynosi @_inProgressCount (limit: 20)
        </MudAlert>
    }

    <MudCard Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect Value="_query.Status"
                               ValueChanged="OnStatusFilterChanged"
                               Label="Status"
                               Placeholder="Status"
                               Variant="Variant.Outlined"
                               T="BatchStatus?"
                               Clearable="true"
                               Class="kanban-filter-input">
                        <MudSelectItem Value="@((BatchStatus?)null)">Wszystkie</MudSelectItem>
                        <MudSelectItem Value="@((BatchStatus?)BatchStatus.New)">New</MudSelectItem>
                        <MudSelectItem Value="@((BatchStatus?)BatchStatus.InProgress)">InProgress</MudSelectItem>
                        <MudSelectItem Value="@((BatchStatus?)BatchStatus.Done)">Done</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect Value="_query.Stage"
                               ValueChanged="OnStageFilterChanged"
                               Label="Etap"
                               Placeholder="Etap"
                               Variant="Variant.Outlined"
                               T="ProductionStage?"
                               Clearable="true"
                               Class="kanban-filter-input">
                        <MudSelectItem Value="@((ProductionStage?)null)">Wszystkie</MudSelectItem>
                        <MudSelectItem Value="@((ProductionStage?)ProductionStage.Design)">Design (1)</MudSelectItem>
                        <MudSelectItem Value="@((ProductionStage?)ProductionStage.Print)">Print (2)</MudSelectItem>
                        <MudSelectItem Value="@((ProductionStage?)ProductionStage.Cut)">Cut (3)</MudSelectItem>
                        <MudSelectItem Value="@((ProductionStage?)ProductionStage.Pack)">Pack (4)</MudSelectItem>
                        <MudSelectItem Value="@((ProductionStage?)ProductionStage.Ship)">Ship (5)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField Value="_query.Q"
                                   ValueChanged="@(EventCallback.Factory.Create<string?>(this, OnSearchTextChanged))"
                                   Label="Wyszukaj (numer zlecenia/projektu)"
                                   Placeholder="Wyszukaj (numer zlecenia/projektu)"
                                   Variant="Variant.Outlined"
                                   Immediate="false"
                                   Class="kanban-filter-input" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               FullWidth="true"
                               OnClick="OnClearFilters"
                               Class="mt-4">
                        Wyczyść filtry
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <KanbanTable Batches="_batches"
                 Query="_query"
                 InProgressCount="_inProgressCount"
                 OnStatusChanged="OnStatusChanged"
                 OnStageChanged="OnStageChanged"
                 OnQueryChanged="OnQueryChanged" />

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
    }
</MudContainer>
