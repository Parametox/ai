@page "/login"
@attribute [AllowAnonymous]
@layout UnauthLayout
@using Microsoft.AspNetCore.Authorization

<PageTitle>Logowanie - KanbanLite</PageTitle>

<div class="login-container">
    <div class="login-card">
        <h1 class="login-title">KanbanLite</h1>
        <p class="login-subtitle">Zaloguj się do systemu</p>

        @if (_hasError)
        {
            <div class="alert alert-error mb-4">
                <span>Nieprawidłowa nazwa użytkownika lub hasło</span>
                <button type="button" class="alert-close" @onclick="ClearError" aria-label="Zamknij">×</button>
            </div>
        }

        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" class="login-form" data-testid="login-form">
            <div class="form-group">
                <label for="username" class="form-label">Nazwa użytkownika</label>
                <InputText @bind-Value="_loginModel.Username"
                           id="username" 
                           class="form-input" 
                           autocomplete="username"
                           data-testid="login-username" />
            </div>
            
            <div class="form-group">
                <label for="password" class="form-label">Hasło</label>
                <InputText type="password"
                           @bind-Value="_loginModel.Password"
                           id="password" 
                           class="form-input" 
                           autocomplete="current-password"
                           data-testid="login-password" />
            </div>
            
            <button type="submit" class="btn btn-primary btn-full" disabled="@_isLoading" data-testid="login-submit">
                <span>@(_isLoading ? "Logowanie..." : "Zaloguj")</span>
            </button>
        </EditForm>
    </div>
</div>
