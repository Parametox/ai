@page "/login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Logowanie - KanbanLite</PageTitle>

<div class="login-container">
    <div class="login-card">
        <h1 class="login-title">KanbanLite</h1>
        <p class="login-subtitle">Zaloguj się do systemu</p>

        @if (_hasError)
        {
            <div class="alert alert-error mb-4">
                <span>Nieprawidłowa nazwa użytkownika lub hasło</span>
                <button type="button" class="alert-close" @onclick="ClearError" aria-label="Zamknij">×</button>
            </div>
        }

        <form method="post" action="/api/auth/login" class="login-form">
            <div class="form-group">
                <label for="username" class="form-label">Nazwa użytkownika</label>
                <input type="text" 
                       name="username"
                       id="username" 
                       class="form-input" 
                       autocomplete="username"
                       required />
            </div>
            
            <div class="form-group">
                <label for="password" class="form-label">Hasło</label>
                <input type="password" 
                       name="password"
                       id="password" 
                       class="form-input" 
                       autocomplete="current-password" 
                       required />
            </div>
            
            <button type="submit" class="btn btn-primary btn-full">
                <span>Zaloguj</span>
            </button>
        </form>
    </div>
</div>
